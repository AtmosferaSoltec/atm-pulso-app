# Copy to .env (not versioned). Public variables only: no secrets here.
# "real" talks to the APIs below; "mock" works without any server (default).
EXPO_PUBLIC_API_MODE=real
# atm-pulso-api (local: scripts/dev-all.sh start in atm-pulso-api)
EXPO_PUBLIC_PULSO_API_URL=http://localhost:3001/api/v1
# atm-auth-api
EXPO_PUBLIC_AUTH_API_URL=http://localhost:3130
