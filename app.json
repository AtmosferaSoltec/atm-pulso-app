{
  "expo": {
    "name": "Pulso",
    "slug": "atm-pulso-app",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atmpulsoapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.atmosferast.pulso",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "deploymentTarget": "18.0"
    },
    "android": {
      "package": "com.atmosferast.pulso",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#176B80",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f7f9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0b0e12",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Pulso usa la cámara solo para fotografiar comprobantes de pago (Yape/Plin, tarjeta o transferencia).",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pulso usa la cámara solo para fotografiar comprobantes de pago (Yape/Plin, tarjeta o transferencia).",
          "photosPermission": "Pulso abre tus fotos solo para adjuntar el comprobante de un pago.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/with-optional-hardware.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a75a4e7-acdb-49c9-a3fe-cf9af3bd34f6"
      }
    },
    "owner": "atmosfera-st",
    "updates": {
      "url": "https://u.expo.dev/6a75a4e7-acdb-49c9-a3fe-cf9af3bd34f6"
    }
  }
}
